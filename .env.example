# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Robinhood Chain RPC configuration (Mainnet 4663 / Testnet 46630)
ROBINHOOD_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
ROBINHOOD_TESTNET_RPC_URL="https://rpc.testnet.chain.robinhood.com"
ROBINHOOD_CHAIN_ID="4663"

# OpenSea API v2 & Marketplace Configuration
OPENSEA_API_KEY=""
OPENSEA_CHAIN="robinhood"
OPENSEA_COLLECTION_SLUG="onlyhoodpixel"

# Agent Worker & Policy Configuration
DIVORA_CHAIN="robinhood"
DIVORA_CHAIN_ID="4663"
FULFILLER_ADDRESS=""
AGENT_POLL_INTERVAL_MS="10000"
AGENT_MAX_TICKS="1"

# Persistence & Queue Configuration (Optional in local sandbox; required for live DB persistence)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/divora?schema=public"
REDIS_URL="redis://localhost:6379"

# Swap Quote Providers (Fail-closed when unconfigured)
RIALTO_API_KEY=""
UNISWAP_API_KEY=""
